{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "HomePod Bridge",
  "version": "0.1.0",
  "identifier": "com.homepodbridge.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [
      {
        "title": "HomePod Bridge",
        "width": 560,
        "height": 620,
        "resizable": false
      }
    ],
    "security": {
      "csp": null
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "windows": {
      "nsis": {
        "installMode": "perMachine"
      }
    }
  }
}
